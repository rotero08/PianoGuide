---
// src/components/BranchFlag.astro

/**
 * A small pill that marks a page (or section) as an optional branch of the curriculum.
 * Place it directly above a heading; the heading's top margin collapses to sit under it.
 *
 * @example
 * <BranchFlag text="Optional branch · unlocks after Level 1" />
 */
export interface Props {
  /** Text shown on the pill. */
  text: string;
}

const { text } = Astro.props;
---

<span class="branch-flag">
  <span class="legend-dot"></span>
  {text}
</span>

<style>
  .branch-flag {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.45rem !important;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.66rem !important;
    letter-spacing: 0.04em !important;
    color: var(--rose) !important;
    border: 1px solid rgba(var(--rose-rgb), 0.4) !important;
    border-radius: 999px !important;
    padding: 0.3rem 0.75rem !important;
    margin-bottom: 0.5rem !important;
    width: max-content !important;
  }
  .legend-dot {
    width: 11px !important;
    height: 11px !important;
    border-radius: 50% !important;
    flex-shrink: 0 !important;
    background: transparent !important;
    border: 2px solid var(--rose) !important;
  }

  /* Starlight wraps headings in a div with a large top margin; pull it up under the flag. */
  .branch-flag + :global(.sl-heading-wrapper) {
    margin-top: 0.5rem !important;
  }
</style>
