---
// src/components/ResourceColumn.astro
import Icon from './Icon.astro';
import { sectionAnchor } from '../utils/outline';

/**
 * One of the two study columns at the top of a level ("Technique" and "Sight-Reading"). Holds
 * `<Resource variant="drawer">` rows and, optionally, one `<AlternativesBox>` at the end. The
 * header shows how many of the column's resources the reader has marked done.
 *
 * @example
 * <ResourceColumn id="reading" title="Sight-Reading" subtitle="Graded reading, hands together." accentColor="rose">
 *   <Resource variant="drawer" id="lvl1-bartok" title="Bartók: Mikrokosmos, Book 1" link="https://imslp.org/" tags="imslp" />
 * </ResourceColumn>
 */
export interface Props {
  /**
   * Which column this is. Picks the header icon (hand / eye); `reading` also adds the
   * "THE EYES · HANDS-TOGETHER" tag. Use each value at most once per page.
   */
  id: 'technique' | 'reading';
  /**
   * Heading of the column. Listed in the page's "On this page" outline.
   * @outline 2
   */
  title: string;
  /**
   * Description under the heading. Supports Markdown-style links: `[text](url)`.
   * @example subtitle="Posture details live in [Technique 1](/technique/technique-1/)."
   */
  subtitle?: string;
  /**
   * Colour of the top edge, icon and progress bar.
   * @default "gold"
   */
  accentColor?: 'gold' | 'rose';
}

const { id, title, subtitle, accentColor = 'gold' } = Astro.props;

// The subtitle arrives as a plain attribute string, so its [text](url) links are converted here.
const subtitleHtml = subtitle?.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---

<div class:list={['res-column-wrapper', id, accentColor]} id={id}>
  <div class="res-column-header">
    <div class="res-title-box">
      <Icon name={id === 'technique' ? 'hand' : 'eye'} class="col-header-svg" strokeWidth={1.8} />
      <h3 id={sectionAnchor(title)}>{title}</h3>
      {id === 'reading' && <span class="res-reading-tag-meta">THE EYES · HANDS-TOGETHER</span>}
    </div>

    {subtitleHtml && <p class="res-column-subtitle" set:html={subtitleHtml} />}

    <div class="column-track-progress">
      <div class="ct-progress-bar-bg">
        <div class="ct-progress-bar-fg" data-progress-bar></div>
      </div>
      <span class="ct-progress-text" data-progress-label>0/0 done</span>
    </div>
  </div>

  <div class="res-list-container">
    <slot />
  </div>
</div>

<style>
  .res-column-wrapper {
    background-color: var(--bg-card) !important;
    border: 1px solid var(--border-color) !important;
    border-radius: var(--radius) !important;
    padding: 1.6rem !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
  }
  .res-column-wrapper.gold {
    border-top: 3px solid var(--gold) !important;
  }
  .res-column-wrapper.rose {
    border-top: 3px solid var(--rose) !important;
  }
  .res-column-header {
    margin-bottom: 0.3rem !important;
  }
  .res-title-box {
    display: flex !important;
    align-items: center !important;
    gap: 0.55rem !important;
    margin-bottom: 0.45rem !important;
    flex-wrap: wrap !important;
  }
  .res-title-box h3 {
    margin: 0 !important;
    font-family: 'Space Grotesk', sans-serif !important;
    font-size: 1.15rem !important;
    color: var(--text-main) !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
  }
  .col-header-svg {
    width: 18px !important;
    height: 18px !important;
    flex-shrink: 0 !important;
  }
  .gold .col-header-svg { color: var(--gold) !important; }
  .rose .col-header-svg { color: var(--rose) !important; }

  .res-reading-tag-meta {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.58rem !important;
    color: var(--rose) !important;
    letter-spacing: 0.08em !important;
    margin-left: 0.35rem !important;
  }
  .res-column-subtitle {
    font-size: 0.88rem !important;
    line-height: 1.55 !important;
    color: var(--text-muted) !important;
    margin: 0 0 1rem 0 !important;
  }
  .res-column-subtitle :global(a) {
    color: var(--gold) !important;
    text-decoration: underline !important;
  }
  .column-track-progress {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
    margin-top: 0.85rem !important;
  }
  .ct-progress-bar-bg {
    width: 60px !important;
    height: 5px !important;
    background-color: rgba(128, 128, 128, 0.2) !important;
    border-radius: 3px !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
  }
  .ct-progress-bar-fg {
    height: 100% !important;
    width: 0%;
    border-radius: 3px !important;
    transition: width 0.3s ease-out !important;
  }
  .gold .ct-progress-bar-fg { background-color: var(--gold) !important; }
  .rose .ct-progress-bar-fg { background-color: var(--rose) !important; }
  .ct-progress-text {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.68rem !important;
    color: var(--text-muted) !important;
    white-space: nowrap !important;
    font-weight: 700 !important;
  }
  .res-list-container {
    display: flex !important;
    flex-direction: column !important;
  }
</style>
