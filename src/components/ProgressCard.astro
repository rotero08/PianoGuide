---
// src/components/ProgressCard.astro
import { getContentIndex } from '../utils/contentIndex';

/**
 * A compact card with the live completion percentage and progress bar of one track. Works on
 * any page: the track's task list comes from the build, the ticks from the reader's browser.
 *
 * @example
 * <ProgressCard trackId="lvl1" title="Level 1: Intervals & Chords" />
 */
export interface Props {
  /**
   * Progress track to summarise: counts every `<Task>` with this `trackId`, wherever it lives.
   * @example trackId="lvl1"
   */
  trackId: string;
  /** Name of the track shown on the card. */
  title: string;
}

const { trackId, title } = Astro.props;
const taskIds = (await getContentIndex()).tasks[trackId] ?? [];
---

<div class="po-row" data-progress-tasks={taskIds.join(' ')}>
  <div class="po-top">
    <span class="po-name">{title}</span>
    <span class="po-pct" data-progress-label>0%</span>
  </div>
  <div class="po-bar-bg">
    <div class="po-bar-fg" data-progress-bar></div>
  </div>
</div>

<script>
  import '../scripts/progress';
</script>

<style>
  .po-row {
    background: var(--bg-card) !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 8px !important;
    padding: 0.85rem 1.1rem !important;
    box-sizing: border-box !important;
    transition: transform 0.15s ease, border-color 0.15s ease !important;
    width: 100% !important;
  }
  .po-row:hover {
    transform: translateY(-1px) !important;
    border-color: var(--gold) !important;
  }

  .po-top {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 0.85rem !important;
    margin-bottom: 0.5rem !important;
    gap: 0.5rem !important;
  }

  .po-name {
    color: var(--text-main) !important;
    font-weight: 500 !important;
    font-size: 0.86rem !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .po-pct {
    font-family: 'JetBrains Mono', monospace !important;
    color: var(--gold) !important;
    font-weight: 700 !important;
    font-size: 0.78rem !important;
    flex-shrink: 0 !important;
  }

  .po-bar-bg {
    height: 5px !important;
    background: rgba(128, 128, 128, 0.2) !important;
    border-radius: 3px !important;
    overflow: hidden !important;
    width: 100% !important;
  }

  .po-bar-fg {
    height: 100% !important;
    width: 0%;
    background: var(--gold) !important;
    border-radius: 3px !important;
    transition: width 0.5s ease-out !important;
  }
</style>
