---
// src/components/Collapsible.astro
import Icon from './Icon.astro';
import type { IconChoice } from './icons';

/**
 * An accordion block for supplementary lessons. Inside it, each `####` heading starts a new
 * sub-section separated by a divider.
 *
 * @example
 * <Collapsible title="Active Audiation Practice">
 *   #### Sing before you play
 *   Hum the first interval of the phrase, then check it at the keyboard.
 * </Collapsible>
 */
export interface Props {
  /** Heading shown in the always-visible summary row. */
  title: string;
  /**
   * Starts expanded.
   * @default false
   */
  open?: boolean;
  /**
   * Icon shown beside the title.
   * @default "play-box"
   */
  icon?: IconChoice;
}

const { title, open = false, icon = 'play-box' } = Astro.props;
---

<details class="collapsible-widget" open={open}>
  <summary class="collapsible-header">
    <h3>
      {icon !== 'none' && <Icon name={icon} class="collapsible-svg" />}
      {title}
    </h3>
    <span class="collapse-arrow">
      <Icon name="chevron-down" />
    </span>
  </summary>
  <div class="collapsible-content">
    <slot />
  </div>
</details>

<style>
  .collapsible-widget {
    background-color: var(--bg-card) !important;
    border: 1px solid var(--border-color) !important;
    border-radius: var(--radius) !important;
    margin: 2rem 0 !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    padding: 0 !important;
  }

  .collapsible-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 0.9rem 1rem !important;
    background-color: transparent !important;
    margin: 0 !important;
    width: 100% !important;
    box-sizing: border-box !important;
    cursor: pointer !important;
    user-select: none !important;
    list-style: none !important;
    transition: background-color 0.2s !important;
  }
  .collapsible-header::-webkit-details-marker {
    display: none !important;
  }
  .collapsible-header::marker {
    content: "" !important;
  }
  .collapsible-header::before,
  .collapsible-header::after {
    display: none !important;
    content: none !important;
  }
  .collapsible-header:hover {
    background-color: rgba(255, 255, 255, 0.02) !important;
  }

  .collapsible-header h3 {
    margin: 0 !important;
    font-size: 1.05rem !important;
    display: flex !important;
    align-items: center !important;
    gap: 0.45rem !important;
    color: var(--gold) !important;
    font-family: 'Space Grotesk', var(--sl-font), sans-serif !important;
    font-weight: 700 !important;
  }
  .collapsible-svg {
    width: 18px !important;
    height: 18px !important;
    color: inherit !important;
  }

  .collapse-arrow {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 18px !important;
    height: 18px !important;
    color: var(--text-muted) !important;
    transition: transform 0.2s ease !important;
  }
  .collapse-arrow :global(svg) {
    width: 100% !important;
    height: 100% !important;
  }
  .collapsible-widget[open] .collapse-arrow {
    transform: rotate(180deg) !important;
  }

  .collapsible-content {
    padding: 0.2rem 1rem 1.2rem 1rem !important;
  }
  .collapsible-content :global(h4) {
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    color: var(--text-main) !important;
    margin-top: 1.3rem !important;
    margin-bottom: 0.35rem !important;
    font-family: 'Space Grotesk', var(--sl-font), sans-serif !important;
  }
  .collapsible-content :global(h4:first-of-type) {
    border-top: none !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
  }
  .collapsible-content :global(h4 ~ h4) {
    border-top: 1px solid var(--border-color) !important;
    padding-top: 1.3rem !important;
  }
  .collapsible-content :global(p) {
    font-size: 0.88rem !important;
    color: var(--text-muted) !important;
    line-height: 1.55 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  .collapsible-content :global(h4 a) {
    color: var(--gold) !important;
    font-weight: 700 !important;
    font-size: 0.8rem !important;
    text-decoration: none !important;
    margin-left: 0.25rem !important;
    display: inline-block !important;
    transition: color 0.15s ease !important;
  }
  .collapsible-content :global(h4 a:hover) {
    text-decoration: underline !important;
  }

  /* Headings inside the accordion don't get Starlight's hover anchor links. */
  .collapsible-content :global(:is(h1, h2, h3, h4, h5, h6) + a),
  .collapsible-content :global(.anchor),
  .collapsible-content :global(.heading-link) {
    display: none !important;
  }
</style>
