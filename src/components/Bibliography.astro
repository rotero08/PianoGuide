---
// src/components/Bibliography.astro
import { getContentIndex } from '../utils/contentIndex';

/**
 * The numbered academic bibliography. Write one list item per source, each starting with a
 * `#ref-N` marker; at build time the marker becomes a stable `#ref-<author>` anchor and is
 * replaced by "^" backlinks to every place in the guide that cites the source.
 *
 * Cite a source anywhere with `[N](/reference/library/#ref-N)`.
 *
 * @example
 * <Bibliography>
 *   * #ref-1 **Rubin-Rabson, G. (1940).** *Studies in the psychology of memorizing piano music.*
 * </Bibliography>
 */
export interface Props {}

const { numToSlug, backlinks } = await getContentIndex();

function backlinksFor(slug: string): string {
  const cites = backlinks[slug] ?? [];
  if (cites.length === 0) return '';
  const links =
    cites.length === 1
      ? `<a href="${cites[0].url}" class="backlink-arrow" title="Back to citation">^</a> `
      : '<span class="backlink-arrow-text">^</span> ' +
        cites
          .map(({ url }, i) => {
            const letter = String.fromCharCode(97 + i);
            return `<a href="${url}" class="backlink-letter" title="Back to citation ${letter}">${letter}</a> `;
          })
          .join('');
  return `<span class="backlink-span">${links}</span>`;
}

const list = (await Astro.slots.render('default')).replace(/<li>\s*#ref-(\d+)\s*/g, (item, num) => {
  const slug = numToSlug[num];
  return slug ? `<li id="ref-${slug}">${backlinksFor(slug)}` : item;
});
---

<div class="bibliography-container">
  <Fragment set:html={list} />
</div>

<style>
  .bibliography-container {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 1.2rem 1.6rem;
    margin: 1.5rem 0;
  }

  .bibliography-container :global(ul) {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    counter-reset: bib-counter;
    display: block !important;
  }

  @media (min-width: 768px) {
    .bibliography-container :global(ul) {
      column-count: 2 !important;
      column-gap: 2rem !important;
    }
  }

  .bibliography-container :global(li) {
    counter-increment: bib-counter;
    position: relative !important;
    margin: 0 0 0.5rem !important;
    padding: 0 0 0 2.4rem !important;
    font-size: 0.9rem !important;
    line-height: 1.6 !important;
    color: var(--text-muted) !important;
    scroll-margin-top: 6rem;
    break-inside: avoid !important;
  }

  .bibliography-container :global(li:last-child) {
    margin-bottom: 0 !important;
  }

  /* Numbered Brackets */
  .bibliography-container :global(li::before) {
    content: "[" counter(bib-counter) "]" !important;
    position: absolute !important;
    left: 0 !important;
    width: 2rem !important;
    white-space: nowrap !important;
    text-align: right !important;
    font-family: var(--sl-font-mono) !important;
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    color: var(--gold) !important;
  }

  .bibliography-container :global(li strong) {
    color: var(--text-main) !important;
  }

  /* Backlinks styling */
  .bibliography-container :global(.backlink-span) {
    margin-right: 0.5rem !important;
    font-family: var(--sl-font-mono) !important;
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    display: inline-block !important;
  }

  .bibliography-container :global(.backlink-arrow),
  .bibliography-container :global(.backlink-letter) {
    color: var(--gold) !important;
    text-decoration: none !important;
    transition: color 0.15s ease !important;
  }

  .bibliography-container :global(.backlink-arrow-text) {
    color: var(--sl-color-gray-1) !important;
    opacity: 0.45;
  }

  .bibliography-container :global(.backlink-arrow:hover),
  .bibliography-container :global(.backlink-letter:hover) {
    text-decoration: underline !important;
    color: var(--gold-light) !important;
  }

  /* Target-flash Wikipedia effect */
  @keyframes target-flash {
    0% {
      background-color: var(--sl-color-accent-low);
      box-shadow: 0 0 0 6px var(--sl-color-accent-low);
      border-radius: 4px;
    }
    100% {
      background-color: transparent;
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .bibliography-container :global(li:target) {
    animation: target-flash 2.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>
