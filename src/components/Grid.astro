---
// src/components/Grid.astro

/** One entry of the category dropdown of a searchable grid. */
export interface FilterOption {
  /** Category to show; matched against each card's category. Use `all` for the "show everything" entry. */
  value: string;
  /** Text shown in the dropdown. */
  label: string;
}

/**
 * Lays its children out in a responsive grid. By default columns auto-fill at `minWidth`;
 * `cols` forces a fixed count instead (collapsing to one column on narrow screens).
 * Optionally adds a live search box and category dropdown over the `<Resource>` / `<Card>` tiles inside.
 *
 * @example
 * <Grid cols={2}>
 *   <Card title="One">…</Card>
 *   <Card title="Two">…</Card>
 * </Grid>
 */
export interface Props {
  /**
   * Fixed number of equal-width columns. Omit to auto-fill by `minWidth`.
   * @example cols={3}
   */
  cols?: number;
  /**
   * Narrowest a column may get before the grid wraps (any CSS length). Ignored when `cols` is set.
   * @default "320px"
   */
  minWidth?: string;
  /**
   * Space between cells (any CSS length).
   * @default "1.5rem"
   */
  gap?: string;
  /**
   * Adds a search box that filters the tiles inside as you type.
   * @default false
   */
  searchable?: boolean;
  /**
   * Placeholder of the search box.
   * @default "Search..."
   */
  placeholder?: string;
  /**
   * Adds a category dropdown next to the search box. Requires `searchable`.
   * @example filterOptions={[{ value: 'all', label: 'ALL CATEGORIES' }, { value: 'theory', label: 'MUSIC THEORY' }]}
   */
  filterOptions?: FilterOption[];
  /**
   * Shows the "Mandatory spine / Optional branch" colour legend above the grid.
   * @default false
   */
  legend?: boolean;
}

const {
  cols,
  minWidth = '320px',
  gap = '1.5rem',
  searchable = false,
  placeholder = 'Search...',
  filterOptions = [],
  legend = false,
} = Astro.props;

const gridStyle = {
  gap,
  gridTemplateColumns: cols ? `repeat(${cols}, minmax(0, 1fr))` : `repeat(auto-fill, minmax(${minWidth}, 1fr))`,
};
---

<div class:list={['grid-container', { 'cols-forced': !!cols }]} data-searchable={searchable || undefined}>
  {legend && (
    <div class="legend-row">
      <span class="legend-chip">
        <span class="legend-dot mand"></span> Mandatory spine
      </span>
      <span class="legend-chip">
        <span class="legend-dot opt"></span> Optional branch (unlocks as you progress)
      </span>
    </div>
  )}

  {searchable && (
    <div class="filter-group">
      <input type="text" class="input-filter" placeholder={placeholder} />
      {filterOptions.length > 0 && (
        <select class="select-filter">
          {filterOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      )}
    </div>
  )}

  <div class="grid-layout" style={gridStyle}>
    <slot />
  </div>
</div>

{searchable && (
  <script>
    import '../scripts/gridFilter';
  </script>
)}

<style>
  .grid-container {
    width: 100%;
    margin: 1.5rem 0 2.5rem;
  }
  .legend-row {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.6rem 1.5rem !important;
    margin-bottom: 1.2rem !important;
    align-items: center !important;
    width: 100% !important;
  }
  .legend-chip {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    font-size: 0.82rem !important;
    color: var(--text-muted) !important;
    font-family: 'JetBrains Mono', monospace !important;
    letter-spacing: 0.02em !important;
  }
  .legend-dot {
    width: 11px !important;
    height: 11px !important;
    border-radius: 50% !important;
    flex-shrink: 0 !important;
  }
  .legend-dot.mand {
    background: var(--gold) !important;
  }
  .legend-dot.opt {
    background: transparent !important;
    border: 2px solid var(--rose) !important;
  }
  .filter-group {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .input-filter {
    flex: 1;
    min-width: 220px;
    padding: 0.7rem 1rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-main);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s ease-in-out;
  }
  .input-filter:focus {
    border-color: var(--gold);
  }

  .select-filter {
    padding: 0.7rem 1rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-main);
    font-size: 0.82rem;
    font-family: 'JetBrains Mono', monospace;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s ease-in-out;
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.2rem;

    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23C9A84C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.8rem center;
    background-size: 1.1rem;
  }
  :root[data-theme="light"] .select-filter {
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239a7420' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  }
  .select-filter:focus,
  .select-filter:hover {
    border-color: var(--gold);
  }
  .select-filter option {
    background-color: var(--bg-dark) !important;
    color: var(--text-main) !important;
  }
  .grid-layout {
    display: grid !important;
    align-items: stretch !important;
  }
  @media (max-width: 720px) {
    .cols-forced .grid-layout {
      grid-template-columns: 1fr !important;
    }
  }
  .grid-layout :global(*) {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  .grid-layout > :global(p) {
    display: contents !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .grid-layout :global(p:empty) {
    display: none !important;
    margin: 0 !important;
    padding: 0 !important;
    height: 0 !important;
  }
</style>
