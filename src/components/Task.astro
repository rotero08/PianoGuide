---
// src/components/Task.astro
import Icon from './Icon.astro';

/**
 * One row of a level's checklist: a round checkbox, the task text, and an optional link button.
 * Ticking it is saved in the reader's browser and feeds the progress bars of its track.
 *
 * `id` and `trackId` must be written as plain string literals: the build reads them straight
 * from the page source to work out which tasks make up each track.
 *
 * @example
 * <Task id="check-prestaff-posture" trackId="prestaff" link="/technique/technique-1/">
 *   **Posture drop:** Drop each hand freely onto keys with loose, springy wrists.
 * </Task>
 */
export interface Props {
  /**
   * Unique id of this task across the whole site; it is the key the tick is saved under.
   * @example id="check-lvl1-triads"
   */
  id: string;
  /**
   * The progress track this task counts towards. Use the same value as the `trackId` of the
   * level's `<VerificationBox>` / `<ProgressCard>`.
   * @example trackId="lvl1"
   */
  trackId: string;
  /**
   * Small frequency/category badge shown before the text.
   * @default "none"
   */
  tag?: 'daily' | 'weekly' | 'monthly' | 'check' | 'prereq' | 'none';
  /**
   * URL or site path of the material for this task. Adds a small button at the end of the row.
   * @example link="/harmony/lead-sheets/"
   */
  link?: string;
  /**
   * Label of the `link` button. Convention: `go →` for pages of this site, `open ↗` for external sites.
   * @default "go →"
   */
  linkText?: string;
}

const { id, tag = 'none', link, linkText = 'go →' } = Astro.props;
const tagLabel = tag[0].toUpperCase() + tag.slice(1);
---

<div class="task-row-container">
  <div class="task-interactive-left">
    <div class="task-checkbox-wrapper">
      <input type="checkbox" id={id} class="task-checkbox-input" />
      <label for={id} class="task-checkbox-label">
        <span class="sr-only">Mark task as complete</span>
        <Icon name="check" class="checkmark-svg" strokeWidth={3} />
      </label>
    </div>

    {tag !== 'none' && <span class:list={['task-tag-badge', `tag-${tag}`]}>{tagLabel}</span>}

    <div class="task-body-content">
      <slot />
    </div>
  </div>

  {link && <a href={link} class="task-nav-btn">{linkText}</a>}
</div>

<script>
  import '../scripts/progress';
</script>

<style>
  .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border-width: 0 !important;
  }

  .task-row-container {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 0.85rem !important;
    padding: 0.8rem 0 !important;
    border-bottom: 1px solid var(--border-color) !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  .task-row-container:last-child {
    border-bottom: none !important;
  }

  .task-interactive-left {
    display: flex !important;
    align-items: center !important;
    gap: 0.85rem !important;
    flex-grow: 1 !important;
    min-width: 0 !important;
  }

  .task-checkbox-wrapper {
    position: relative !important;
    width: 20px !important;
    height: 20px !important;
    flex-shrink: 0 !important;
  }

  .task-checkbox-input {
    opacity: 0 !important;
    position: absolute !important;
    inset: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    z-index: 2 !important;
  }

  .task-checkbox-label {
    position: absolute !important;
    inset: 0 !important;
    border: 2px solid rgba(128, 128, 128, 0.2) !important;
    border-radius: 50% !important;
    background-color: transparent !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background-color 0.15s, border-color 0.15s !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .task-checkbox-input:hover + .task-checkbox-label {
    border-color: var(--gold) !important;
  }
  .task-checkbox-input:checked + .task-checkbox-label {
    background-color: var(--gold) !important;
    border-color: var(--gold) !important;
  }

  .checkmark-svg {
    width: 11px !important;
    height: 11px !important;
    color: var(--sl-color-black) !important;
    opacity: 0 !important;
    transform: scale(0.5) !important;
    transition: transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.15s !important;
  }
  :root[data-theme="light"] .checkmark-svg {
    color: var(--sl-color-bg) !important;
  }
  .task-checkbox-input:checked + .task-checkbox-label .checkmark-svg {
    opacity: 1 !important;
    transform: scale(1) !important;
  }

  .task-tag-badge {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.54rem !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    padding: 0.3rem 0.45rem !important;
    border-radius: 5px !important;
    flex-shrink: 0 !important;
    font-weight: 700 !important;
    width: 74px !important;
    text-align: center !important;
  }
  .tag-daily {
    background-color: rgba(var(--gold-rgb), 0.15) !important;
    color: var(--gold) !important;
  }
  .tag-weekly {
    background-color: rgba(212, 118, 138, 0.15) !important;
    color: var(--rose) !important;
  }
  .tag-monthly,
  .tag-check {
    background-color: rgba(142, 134, 224, 0.15) !important;
    color: var(--badge-imslp) !important;
  }
  .tag-prereq {
    background-color: rgba(30, 41, 59, 0.4) !important;
    color: var(--text-muted) !important;
  }

  .task-body-content {
    font-size: 0.92rem !important;
    line-height: 1.45 !important;
    color: var(--text-muted) !important;
    min-width: 0 !important;
    flex-grow: 1 !important;
  }
  .task-body-content :global(strong) {
    color: var(--text-main) !important;
    font-weight: 700 !important;
  }

  .task-interactive-left:has(.task-checkbox-input:checked) .task-body-content {
    text-decoration: line-through !important;
    text-decoration-color: var(--text-faint) !important;
    opacity: 0.55 !important;
  }

  .task-nav-btn {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.72rem !important;
    color: var(--gold) !important;
    background: var(--bg-card2) !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 6px !important;
    padding: 0.35rem 0.7rem !important;
    flex-shrink: 0 !important;
    cursor: pointer !important;
    transition: all 0.15s !important;
    align-self: center !important;
    font-weight: 600 !important;
  }
  .task-nav-btn:hover {
    background-color: var(--gold) !important;
    border-color: var(--gold) !important;
    color: var(--sl-color-black) !important;
    text-decoration: none !important;
  }
  :root[data-theme="light"] .task-nav-btn:hover {
    color: var(--sl-color-white) !important;
  }
</style>
