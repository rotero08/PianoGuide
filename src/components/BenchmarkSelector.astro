---
// src/components/BenchmarkSelector.astro
import Icon from './Icon.astro';
import Drawer from './ui/Drawer.astro';

/**
 * The "choose your primary era benchmark" picker of a level. Wrap the level's era pieces
 * (`<Resource variant="card" isBenchmark={true} isPrimarySelectable={true}>`) in it: the reader
 * selects one to focus on, the others move into an "alternatives" drawer, and any of them can
 * be pinned back or ticked off. The choice is saved per `level` in the reader's browser.
 *
 * @example
 * <BenchmarkSelector level="lvl1">
 *   <Resource variant="card" isBenchmark={true} isPrimarySelectable={true} id="lvl1-haydn" era="Classical" title="Haydn: Quadrille" tags="free" sheetUrl="https://…" audioUrl="https://…">
 *     A short, cheerful classical piece.
 *   </Resource>
 * </BenchmarkSelector>
 */
export interface Props {
  /**
   * Unique key for this picker, used to store the reader's choice. Use the level's track id.
   * @example level="lvl1"
   */
  level: string;
}

const { level } = Astro.props;
---

<div class="benchmark-selector-wrapper" data-level={level}>
  <div class="bench-select-callout">
    <div class="bench-select-callout-head">
      <Icon name="target" class="target-svg" strokeWidth={1.8} />
      <h3>Choose Your Primary Era Benchmark</h3>
    </div>
    <p>Please select <strong>one</strong> era piece to focus on for this level. Once chosen, the alternative pieces will automatically move to the "Alternative Era Benchmark Pieces" drawer below. You can change your focus at any time by clicking the pin icon on any active card.</p>
  </div>

  <div class="bench-main-active-list">
    <slot />
  </div>

  <!-- Filled (and revealed) by scripts/benchmarks.ts with the cards that are neither selected nor pinned. -->
  <Drawer title="Alternative Era Benchmark Pieces" class="bench-alt-drawer" hidden>
    <div class="alt-benchmarks-list"></div>
  </Drawer>
</div>

<script>
  import '../scripts/benchmarks';
</script>

<style>
  .benchmark-selector-wrapper {
    margin-top: 1.5rem !important;
    width: 100% !important;
  }

  .bench-select-callout {
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.05) 0%, rgba(19, 27, 46, 0.2) 100%) !important;
    border: 1px solid var(--border-color) !important;
    border-left: 4px solid var(--gold) !important;
    border-radius: var(--radius) !important;
    padding: 1.25rem 1.5rem !important;
    margin-bottom: 1.5rem !important;
    box-sizing: border-box !important;
  }
  :root[data-theme="light"] .bench-select-callout {
    background: linear-gradient(135deg, rgba(154, 116, 32, 0.03) 0%, rgba(244, 239, 231, 0.2) 100%) !important;
  }
  .bench-select-callout-head {
    display: flex !important;
    align-items: center !important;
    gap: 0.55rem !important;
    margin-bottom: 0.5rem !important;
  }
  .bench-select-callout-head h3 {
    margin: 0 !important;
    font-family: 'Space Grotesk', sans-serif !important;
    font-weight: 700 !important;
    font-size: 1.05rem !important;
    color: var(--gold) !important;
    line-height: 1.2 !important;
  }
  .target-svg {
    width: 18px !important;
    height: 18px !important;
    color: var(--gold) !important;
  }
  .bench-select-callout p {
    font-size: 0.9rem !important;
    line-height: 1.6 !important;
    color: var(--text-muted) !important;
    margin: 0 !important;
  }
  .bench-select-callout strong {
    color: var(--text-main) !important;
  }

  .bench-main-active-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 1.1rem !important;
    margin-bottom: 1.5rem !important;
  }

  .bench-alt-drawer {
    margin-top: 1.5rem !important;
  }
  .alt-benchmarks-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.8rem !important;
    width: 100% !important;
    box-sizing: border-box !important;
    padding: 0.8rem 1rem !important;
  }
</style>
