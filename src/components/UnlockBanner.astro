---
// src/components/UnlockBanner.astro
import Icon from './Icon.astro';

/**
 * A dashed rose banner announcing that an optional branch of the curriculum has unlocked,
 * with a button that leads to it. The body text goes inside the tag.
 *
 * @example
 * <UnlockBanner link="/harmony/lead-sheets/">
 *   **Lead Sheets** is now available. It is optional; run it alongside the spine.
 * </UnlockBanner>
 */
export interface Props {
  /**
   * Small uppercase heading beside the lock icon.
   * @default "Optional Branch Unlocked"
   */
  title?: string;
  /** URL or site path the button leads to. */
  link: string;
  /**
   * Label of the button.
   * @default "Open Lead Sheets →"
   */
  buttonText?: string;
}

const { title = 'Optional Branch Unlocked', link, buttonText = 'Open Lead Sheets →' } = Astro.props;
---

<div class="unlock-banner-container">
  <div class="unlock-header-row">
    <div class="unlock-logo-wrapper">
      <Icon name="lock" class="unlock-lock-svg" strokeWidth={1.8} />
    </div>
    <span class="unlock-title">{title}</span>
  </div>
  <div class="unlock-markdown-content">
    <slot />
  </div>
  <a href={link} class="unlock-action-btn btn-pill">{buttonText}</a>
</div>

<style>
  .unlock-banner-container {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.55rem !important;
    border: 1px dashed rgba(var(--rose-rgb), 0.45) !important;
    background: rgba(var(--rose-rgb), 0.05) !important;
    border-radius: var(--radius) !important;
    padding: 1.4rem !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1.5rem !important;
    box-sizing: border-box !important;
  }

  .unlock-header-row {
    display: flex !important;
    align-items: center !important;
    gap: 0.65rem !important;
  }
  .unlock-logo-wrapper {
    flex-shrink: 0 !important;
    width: 28px !important;
    height: 28px !important;
    border-radius: 7px !important;
    background: rgba(var(--rose-rgb), 0.15) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .unlock-lock-svg {
    width: 14px !important;
    height: 14px !important;
    color: var(--rose) !important;
  }
  .unlock-title {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.65rem !important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;
    font-weight: 700 !important;
    color: var(--rose) !important;
    line-height: 1 !important;
  }

  .unlock-markdown-content :global(p) {
    font-size: 0.88rem !important;
    line-height: 1.6 !important;
    color: var(--text-muted) !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .unlock-markdown-content :global(strong) {
    color: var(--text-main) !important;
    font-weight: 700 !important;
  }
  .unlock-markdown-content :global(p + p) {
    margin-top: 0.4rem !important;
  }

  .unlock-action-btn {
    align-self: flex-start !important;
    font-weight: 600 !important;
    padding: 0.45rem 1rem !important;
    margin-top: 0.2rem !important;
  }
</style>
