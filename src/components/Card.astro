---
// src/components/Card.astro
import Icon from './Icon.astro';
import type { IconChoice } from './icons';

/**
 * A boxed content tile with an optional icon, badge, stat number and call-to-action button.
 * With `variant="flat"` it is only a borderless column that stacks its children (used to lay
 * out the two halves of a `<VerificationBox>`); every other prop is ignored in that mode.
 *
 * @example
 * <Card border="left" accentColor="gold" icon="map" title="Core Reading Levels" link="/curriculum/pre-staff/" buttonText="Start with Pre-Staff">
 *   Your central reading path, from Pre-Staff up to Level 7.
 * </Card>
 */
export interface Props {
  /**
   * Heading of the card.
   * @example title="Requirements & Checklist"
   */
  title?: string;
  /**
   * Small uppercase line above the heading.
   * @example subtitle="Preparatory Level"
   */
  subtitle?: string;
  /**
   * Thickens one edge of the card and paints it in the accent colour.
   * @default "none"
   */
  border?: 'top' | 'left' | 'none';
  /**
   * Colour of the subtitle, thick edge, icon and badge.
   * @default "gold"
   */
  accentColor?: 'gold' | 'rose' | 'none';
  /**
   * Icon shown above the heading. Only rendered when there is a `title`.
   * @default "none"
   */
  icon?: IconChoice;
  /**
   * URL or site path. When set, a full-width button linking to it is added at the bottom (opens in a new tab).
   * @example link="/curriculum/pre-staff/"
   */
  link?: string;
  /**
   * Label of the `link` button.
   * @default "Open ↗"
   */
  buttonText?: string;
  /**
   * Category the card belongs to, matched by the dropdown of a `<Grid searchable>`.
   * @example category="theory"
   */
  category?: string;
  /**
   * Renders the `title` as a large stat figure in the accent colour.
   * @default false
   */
  isStat?: boolean;
  /**
   * Text of a small pill shown at the top-right.
   * @example badge="MANDATORY"
   */
  badge?: string;
  /**
   * `card` is the boxed tile; `flat` is a plain column wrapper.
   * @default "card"
   */
  variant?: 'card' | 'flat';
}

const {
  title,
  subtitle,
  border = 'none',
  accentColor = 'gold',
  icon = 'none',
  link,
  buttonText = 'Open ↗',
  category,
  isStat = false,
  badge,
  variant = 'card',
} = Astro.props;
---

{variant === 'card' ? (
  <div class:list={['unified-card', border !== 'none' && `border-${border}`, accentColor]} data-category={category}>
    <div class="card-meta-row">
      {subtitle && <div class="card-subtitle">{subtitle}</div>}
      {badge && <span class:list={['card-badge', accentColor]}>{badge}</span>}
    </div>

    {title && (
      <div class="card-header">
        {icon !== 'none' && (
          <span class="card-icon" aria-hidden="true">
            <Icon name={icon} class="card-svg" />
          </span>
        )}
        <h4 class:list={['card-title', { 'card-title-stat': isStat }]}>{title}</h4>
      </div>
    )}

    <div class="card-content">
      <slot />
    </div>

    {link && (
      <a href={link} target="_blank" rel="noopener" class="btn-link">
        {buttonText}
      </a>
    )}
  </div>
) : (
  <div class="flat-column">
    <slot />
  </div>
)}

<style>
  .unified-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 1.4rem !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    gap: 0.6rem !important;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    height: 100% !important;
    position: relative !important;
  }
  .unified-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
    box-shadow: 0 4px 20px -2px rgba(var(--gold-rgb), 0.05);
  }

  .border-top { border-top-width: 3px !important; }
  .border-left { border-left-width: 3px !important; }
  .gold.border-top { border-top-color: var(--gold) !important; }
  .rose.border-top { border-top-color: var(--rose) !important; }
  .gold.border-left { border-left-color: var(--gold) !important; }
  .rose.border-left { border-left-color: var(--rose) !important; }

  .card-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 0.1rem;
  }
  .card-subtitle {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.6rem !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    font-weight: 700 !important;
  }
  .gold .card-subtitle { color: var(--gold) !important; }
  .rose .card-subtitle { color: var(--rose) !important; }

  .card-badge {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.58rem !important;
    letter-spacing: 0.09em !important;
    text-transform: uppercase !important;
    font-weight: 700 !important;
    padding: 0.28rem 0.55rem !important;
    border-radius: 5px !important;
    display: inline-block !important;
  }
  .card-badge.gold {
    background: rgba(var(--gold-rgb), 0.15) !important;
    color: var(--gold) !important;
    border: 1px solid rgba(var(--gold-rgb), 0.3) !important;
  }
  .card-badge.rose {
    background: rgba(212, 118, 138, 0.15) !important;
    color: var(--rose) !important;
    border: 1px solid rgba(212, 118, 138, 0.3) !important;
  }

  .card-header {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 0.5rem !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .card-icon {
    display: block !important;
    flex-shrink: 0 !important;
  }
  .gold .card-icon { color: var(--gold) !important; }
  .rose .card-icon { color: var(--rose) !important; }
  .card-svg {
    width: 26px !important;
    height: 26px !important;
  }
  .card-title {
    font-family: 'Playfair Display', serif !important;
    font-size: 1.1rem !important;
    color: var(--text-main) !important;
    margin: 0 !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
  }
  .card-title-stat {
    font-size: 2.5rem !important;
    color: var(--gold) !important;
    line-height: 1 !important;
    margin-bottom: 0.5rem !important;
  }
  .card-content {
    font-size: 0.88rem !important;
    line-height: 1.55 !important;
    color: var(--text-muted) !important;
    flex-grow: 1 !important;
    width: 100%;
  }
  .card-content :global(p) {
    margin: 0 !important;
    padding: 0 !important;
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
  }
  .card-content :global(ul) {
    margin: 0.5rem 0 0.5rem 1.2rem !important;
    padding: 0 !important;
    list-style-type: disc !important;
  }
  .card-content :global(li) {
    font-size: 0.88rem !important;
    line-height: 1.55 !important;
    color: var(--text-muted) !important;
    margin-bottom: 0.4rem !important;
  }
  .card-content :global(li strong) {
    color: var(--text-main) !important;
  }

  .flat-column {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.5rem !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  /* Cards placed in a flat column size to their content instead of stretching to the column height. */
  .flat-column :global(.resource-card),
  .flat-column :global(.unified-card) {
    height: auto !important;
  }
</style>
