---
// src/components/Callout.astro
import Icon from './Icon.astro';
import type { IconChoice } from './icons';

/**
 * A highlight panel for goals, warnings, notes and tips.
 *
 * @example
 * <Callout bordered={true} accentColor="gold" label="Your goal for this level" icon="target">
 *   Read two notes at once and simple triads as single visual shapes.
 * </Callout>
 */
export interface Props {
  /**
   * Heading shown at the top of the panel. Takes precedence over `label`.
   * @example title="How to use this list"
   */
  title?: string;
  /**
   * Alternative name for `title` (used when `title` is not set).
   * @example label="Why audiation comes first"
   */
  label?: string;
  /**
   * Icon shown beside the heading. Only rendered when there is a heading.
   * @default "none"
   */
  icon?: IconChoice;
  /**
   * Draws a 1px outline with a thick left edge in the accent colour.
   * @default false
   */
  bordered?: boolean;
  /**
   * Panel background: `dark` (neutral), `tint` (a wash of the accent colour), or `transparent` / `none`.
   * @default "dark"
   */
  bgColor?: 'dark' | 'tint' | 'transparent' | 'none';
  /**
   * Colour of the heading and the bordered edge.
   * @default "gold"
   */
  accentColor?: 'gold' | 'rose' | 'none';
  /**
   * Any CSS colour, applied to the body text.
   * @example textColor="var(--text-main)"
   */
  textColor?: string;
}

const { title, label, icon = 'none', bordered = false, bgColor = 'dark', accentColor = 'gold', textColor } = Astro.props;
const heading = title || label;
const textStyle = textColor ? `color:${textColor}` : undefined;
const clear = bgColor === 'transparent' || bgColor === 'none';
const boxStyle = [clear && 'background-color:transparent', textStyle].filter(Boolean).join(';') || undefined;
---

<div class:list={['callout-container', accentColor, { bordered, tint: bgColor === 'tint' }]} style={boxStyle}>
  {heading && (
    <span class="callout-label">
      {icon !== 'none' && <Icon name={icon} class="callout-svg" />}
      {heading}
    </span>
  )}
  <div class="callout-content" style={textStyle}>
    <slot />
  </div>
</div>

<style>
  .callout-container {
    --accent: var(--gold);
    border: 0 solid var(--border-color);
    border-radius: 0 8px 8px 0;
    padding: 1.5rem;
    margin: 2rem 0;
    box-sizing: border-box;
    background-color: rgba(30, 41, 59, 0.3);
  }
  .callout-container.rose { --accent: var(--rose); }
  .callout-container.none { --accent: transparent; }

  .callout-container.bordered {
    border-width: 1px 1px 1px 4px;
    border-left-color: var(--accent);
    padding: 1.1rem 1.4rem;
  }

  .callout-container.tint.gold { background-color: rgba(201, 168, 76, 0.07); }
  .callout-container.tint.rose { background-color: rgba(212, 118, 138, 0.07); }

  :root[data-theme="light"] .callout-container { background-color: rgba(30, 41, 59, 0.08); }
  :root[data-theme="light"] .callout-container.tint.gold { background-color: rgba(201, 168, 76, 0.05); }
  :root[data-theme="light"] .callout-container.tint.rose { background-color: rgba(212, 118, 138, 0.05); }

  .callout-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Space Grotesk', var(--sl-font), sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--accent);
  }
  .none .callout-label { color: inherit; }

  .callout-svg {
    width: 18px;
    height: 18px;
  }

  .callout-content :global(p) {
    margin: 0;
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .callout-content :global(strong) {
    color: var(--text-main);
  }
</style>
