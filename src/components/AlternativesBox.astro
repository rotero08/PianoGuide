---
// src/components/AlternativesBox.astro
import Drawer from './ui/Drawer.astro';

/**
 * A collapsed drawer of alternative resources, placed as the last child of a `<ResourceColumn>`.
 * Put `<Resource variant="drawer" isAlternative={true}>` rows inside: readers can pin any of
 * them up into the column's main list. The drawer disappears once all of them are pinned.
 *
 * @example
 * <AlternativesBox>
 *   <Resource variant="drawer" isAlternative={true} id="lvl1-kravchuk" title="Michael Kravchuk: 354 Exercises in C" link="https://michaelkravchuk.com/" tags="free" />
 * </AlternativesBox>
 */
export interface Props {
  /**
   * Heading of the drawer.
   * @default "Alternative Method Books & Resources"
   */
  title?: string;
}

const { title = 'Alternative Method Books & Resources' } = Astro.props;
---

<div class="alternatives-wrapper">
  <Drawer title={title}>
    <div class="alt-progress-wrapper">
      <div class="alt-progress-bar-bg">
        <div class="alt-progress-bar-fill-bar" data-progress-bar></div>
      </div>
      <span class="alt-progress-text" data-progress-label>0/0 done</span>
    </div>

    <div class="alternatives-list-container">
      <slot />
    </div>
  </Drawer>
</div>

<style>
  .alternatives-wrapper {
    margin-top: 1.5rem !important;
    width: 100% !important;
  }
  .alt-progress-wrapper {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
    margin-top: 1rem !important;
    margin-bottom: 0rem !important;
    padding: 0 1.5rem !important;
  }
  .alt-progress-bar-bg {
    width: 60px !important;
    height: 5px !important;
    background-color: rgba(128, 128, 128, 0.2) !important;
    border-radius: 3px !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
  }
  .alt-progress-bar-fill-bar {
    height: 100% !important;
    width: 0%;
    background-color: var(--gold) !important;
    border-radius: 3px !important;
    transition: width 0.3s ease-out !important;
  }
  .alt-progress-text {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.68rem !important;
    color: var(--text-muted) !important;
    font-weight: 700 !important;
    white-space: nowrap !important;
  }
  .alternatives-list-container {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 0.8rem 0.8rem 0.8rem !important;
  }
</style>
